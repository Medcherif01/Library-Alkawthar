# Copiez ce fichier en .env et remplacez par votre URI MongoDB Atlas
# Ne jamais commit le fichier .env dans git !

# Exemple : mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/alkawthar?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://VOTRE_USER:VOTRE_MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/alkawthar?retryWrites=true&w=majority
